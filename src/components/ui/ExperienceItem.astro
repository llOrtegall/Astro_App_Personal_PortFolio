---
interface Props {
  title: string;
  company: string;
  description: string;
  date: string;
  tecnologias: string[];
  index?: number;
}
const {
  title,
  company,
  description,
  date,
  tecnologias,
  index = 0,
} = Astro.props;

// Colores alternados para cada experiencia
const colors = [
  {
    dot: "from-blue-500 to-blue-600",
    badge: "from-blue-500/20 to-blue-600/20 border-blue-500/30",
    title: "text-blue-400",
  },
  {
    dot: "from-purple-500 to-purple-600",
    badge: "from-purple-500/20 to-purple-600/20 border-purple-500/30",
    title: "text-purple-400",
  },
];
const colorScheme = colors[index % 2];
---

<!-- Timeline dot con animación -->
<span
  class={`absolute flex items-center justify-center w-6 h-6 sm:w-8 sm:h-8 bg-linear-to-br ${colorScheme.dot} rounded-full -start-3 sm:-start-4 md:-start-5 ring-2 sm:ring-4 ring-gray-900 group-hover:scale-105 transition-transform duration-300`}
>
  <svg
    class="w-3 h-3 sm:w-4 sm:h-4 text-white"
    fill="currentColor"
    viewBox="0 0 20 20"
  >
    <path
      fill-rule="evenodd"
      d="M6 6V5a3 3 0 013-3h2a3 3 0 013 3v1h2a2 2 0 012 2v3.57A22.952 22.952 0 0110 13a22.95 22.95 0 01-8-1.43V8a2 2 0 012-2h2zm2-1a1 1 0 011-1h2a1 1 0 011 1v1H8V5zm1 5a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1z"
      clip-rule="evenodd"></path>
    <path
      d="M2 13.692V16a2 2 0 002 2h12a2 2 0 002-2v-2.308A24.974 24.974 0 0110 15c-2.796 0-5.487-.46-8-1.308z"
    ></path>
  </svg>
</span>

<!-- Card de experiencia -->
<div
  class="bg-linear-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-xl sm:rounded-2xl p-4 sm:p-6 lg:p-7 border border-gray-700/50 shadow-xl hover:shadow-2xl hover:border-gray-600/50 transition-all duration-300 group-hover:transform group-hover:-translate-y-0.5"
>
  <!-- Header -->
  <div class="flex flex-col gap-3 mb-4 sm:mb-6">
    <div class="flex-1">
      <h2
        class="text-lg sm:text-xl md:text-2xl font-bold text-gray-100 mb-1.5 sm:mb-2 leading-tight"
      >
        {company}
      </h2>
      <h3
        class={`text-sm sm:text-base md:text-lg font-semibold ${colorScheme.title} flex items-center gap-2`}
      >
        <svg
          class="w-4 h-4 sm:w-5 sm:h-5 shrink-0"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"
          ></path>
        </svg>
        {title}
      </h3>
    </div>

    <div
      class={`inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 sm:py-2 bg-linear-to-r ${colorScheme.badge} border rounded-full text-xs sm:text-sm font-medium text-gray-200 w-fit`}
    >
      <svg
        class="w-3 h-3 sm:w-4 sm:h-4 shrink-0"
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path
          fill-rule="evenodd"
          d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z"
          clip-rule="evenodd"></path>
      </svg>
      {date}
    </div>
  </div>

  <!-- Descripción con formato mejorado -->
  <div class="mb-4 sm:mb-6">
    <div class="text-gray-300 leading-relaxed space-y-1.5 sm:space-y-2">
      {
        description.split("\n").map((line: string) => (
          <p class="flex items-start gap-2 text-sm md:text-base leading-relaxed">
            {line.trim().startsWith("•") ? (
              <>
                <span class="text-blue-400 mt-1 shrink-0">▸</span>
                <span>{line.replace("•", "").trim()}</span>
              </>
            ) : (
              <span>{line}</span>
            )}
          </p>
        ))
      }
    </div>
  </div>

  <!-- Tecnologías con chips modernos -->
  <div class="border-t border-gray-700/50 pt-4 sm:pt-5">
    <h4
      class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2 sm:mb-3 flex items-center gap-2"
    >
      <svg
        class="w-3 h-3 sm:w-4 sm:h-4"
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path
          d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 11-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z"
        ></path>
      </svg>
      Tech Stack
    </h4>
    <div class="flex flex-wrap gap-1.5 sm:gap-2">
      {
        tecnologias.map((tech) => (
          <span class="px-2 sm:px-3 py-1 sm:py-1.5 bg-linear-to-r from-gray-700/50 to-gray-800/50 border border-gray-600/50 text-gray-200 rounded-lg text-xs md:text-sm font-medium hover:border-blue-500/50 hover:shadow-md transition-all duration-200 backdrop-blur-sm">
            {tech}
          </span>
        ))
      }
    </div>
  </div>
</div>
