---
const { class: className = '', id } = Astro.props;

// Determinar el tipo de contenedor según la sección
const sectionConfig: Record<string, string> = {
  inicio:
    'min-h-[90svh] flex items-center justify-center py-10 sm:py-14 lg:py-16',
  experiencia: 'py-12 sm:py-16 lg:py-20 scroll-mt-24',
  sobremi: 'py-12 sm:py-16 lg:py-20 scroll-mt-24',
  contacto: 'py-12 sm:py-16 lg:py-20 scroll-mt-24',
  proyectos: 'py-12 sm:py-16 lg:py-20 scroll-mt-24',
};

const sectionClasses = sectionConfig[id || ''] || 'py-12 sm:py-16 lg:py-20';
const containerClasses = `w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 ${sectionClasses} ${className}`;
---

<section class={containerClasses} id={id}>
  <slot />
</section>
