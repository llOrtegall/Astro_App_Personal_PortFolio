---
const { class: className = "", id } = Astro.props;

// Determinar el tipo de contenedor según la sección
const sectionConfig: Record<string, string> = {
  inicio: "min-h-screen flex items-center justify-center",
  experiencia: "min-h-screen py-20",
  sobremi: "min-h-screen py-20",
  contacto: "min-h-screen py-20",
  proyectos: "min-h-screen py-20"
};

const sectionClasses = sectionConfig[id || ""] || "min-h-screen py-20";
const containerClasses = `w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 ${sectionClasses} ${className}`;
---

<section class={containerClasses} id={id}>
    <slot />
</section>
