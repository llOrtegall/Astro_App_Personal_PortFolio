---
import ExperienciaItem from './ui/ExperienceItem.astro';

const EXPERIENCIE = [
  {
    title: 'Full Stack Developer - Freelance',
    company: 'Freelance / Proyectos Personales',
    description:
      '• Desarrollo de plataforma full-stack para compartir archivos usando Cloudflare R2 con URLs pre-firmadas y subidas directas desde el navegador.\n• Implementación de web scraper headless con Puppeteer para automatización de extracción de contenido multimedia, incluyendo grabación de audio en tiempo real con FFmpeg.\n• Arquitectura de APIs REST con autenticación JWT, validación con Zod y ORMs (Sequelize) sobre PostgreSQL.\n• Containerización completa con Docker y orquestación mediante Docker Compose con Nginx como reverse proxy.\n• Desarrollo de SPAs modernas con React 19, TypeScript, Vite y Tailwind CSS con componentes Radix UI.\n• Implementación de pipelines de CI/CD y buenas prácticas de desarrollo (Clean Code, SOLID).\n• Gestión de infraestructura cloud (Cloudflare R2) y configuración de servidores Linux.',
    date: 'Jul 2025 --- Actualidad',
    tecnologias: [
      'React',
      'TypeScript',
      'Node.js',
      'Bun',
      'Express',
      'PostgreSQL',
      'Puppeteer',
      'Docker',
      'Cloudflare R2',
      'Nginx',
      'FFmpeg',
    ],
  },
  {
    title: 'Analista De Aplicaciones - Full Stack Developer',
    company: 'Grupo Empresarial Multired S.A',
    description:
      '• Desarrollo de aplicaciones full stack con Node.js, Express y TypeScript para sistemas empresariales de alta disponibilidad.\n• Diseño e implementación de arquitecturas escalables con microservicios dockerizados y exposición de APIs REST.\n• Gestión y optimización de bases de datos relacionales (MySQL, Oracle) y NoSQL (MongoDB).\n• Implementación de pipelines CI/CD con Jenkins para automatización de despliegues.\n• Containerización de servicios con Docker Compose y gestión de infraestructura.\n• Monitoreo y análisis de rendimiento con Grafana y logging centralizado.\n• Desarrollo de integraciones con sistemas legacy y APIs de terceros.',
    date: 'Nov 2023 --- Jul 2025',
    tecnologias: [
      'Node.js',
      'TypeScript',
      'Express',
      'MySQL',
      'Oracle',
      'MongoDB',
      'Docker',
      'Jenkins',
      'Grafana',
      'REST APIs',
    ],
  },
  {
    title: 'Técnico de Soporte y Mantenimiento',
    company: 'Grupo Empresarial Multired S.A',
    description:
      '• Soporte técnico nivel 2 y 3 para usuarios internos y externos.\n• Administración de servidores Linux y Windows.\n• Configuración de redes, servicios y dispositivos corporativos.\n• Testing de aplicaciones web y móviles en diferentes entornos.\n• Resolución de incidencias mediante scripting (bash/shell).\n• Documentación técnica de procedimientos y soluciones.',
    date: '2020 --- 2023',
    tecnologias: [
      'Linux',
      'Windows Server',
      'Networking',
      'Bash/Shell',
      'Troubleshooting',
    ],
  },
];
---

<section class="max-w-6xl mx-auto px-2 sm:px-4 lg:px-6">
  <!-- Título de la sección -->
  <div class="text-center mb-8 sm:mb-10 lg:mb-12">
    <h1
      class="text-3xl sm:text-4xl md:text-5xl font-bold bg-linear-to-r from-blue-400 via-purple-500 to-pink-500 bg-clip-text text-transparent mb-3"
    >
      Experiencia Laboral
    </h1>
    <div
      class="w-20 sm:w-24 h-1 bg-linear-to-r from-blue-400 to-purple-500 mx-auto rounded-full"
    >
    </div>
  </div>

  <!-- Timeline -->
  <ol
    class="relative border-s-2 border-gradient-to-b from-blue-500 via-purple-500 to-pink-500 ml-1 sm:ml-3 md:ml-6"
  >
    {
      EXPERIENCIE.map((item, index) => (
        <li class="mb-6 sm:mb-10 md:mb-12 ms-4 sm:ms-5 md:ms-8 group">
          <ExperienciaItem {...item} index={index} />
        </li>
      ))
    }
  </ol>
</section>

<style>
  .experience-description {
    padding: 1rem;
  }
  .experience-list {
    list-style: none;
    padding-left: 1rem;
  }
  .experience-list > li {
    margin-bottom: 1rem;
    position: relative;
  }
  .experience-list > li:before {
    content: "→";
    position: absolute;
    left: -1rem;
  }
  .sub-list {
    list-style: disc;
    padding-left: 2rem;
    margin-top: 0.5rem;
  }
  .sub-list li {
    margin-bottom: 0.25rem;
  }
</style>
